{
	"name": "@umiak/template-builder",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "umiak-tpl: builds Proxmox VM templates from recipes",
	"bin": {
		"umiak-tpl": "./src/main.ts"
	},
	"scripts": {
		"umiak-tpl": "node src/main.ts",
		"test": "vitest run",
		"build": "tsc --noEmit -p .",
		"typecheck": "tsc --noEmit -p ."
	},
	"dependencies": {
		"@umiak/pve": "workspace:*",
		"@umiak/db": "workspace:*",
		"openpgp": "6.3.2",
		"smol-toml": "1.9.1",
		"yaml": "2.9.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"fast-xml-parser": "5.11.2"
	}
}
