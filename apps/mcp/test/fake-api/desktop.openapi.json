		"/v1/sandboxes/{sandbox}/desktop/screenshot": {
			"get": {
				"operationId": "desktop.screenshot",
				"summary": "Screenshot",
				"tags": ["desktop"],
				"description": "S10 §12.1, §13.2. Scope desktop. The image is scaled to fit maxWidth x maxHeight (never upscaled).",
				"parameters": [
					{
						"name": "sandbox",
						"in": "path",
						"required": true,
						"description": "Sandbox id (`sb_...`) or slug",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "format",
						"in": "query",
						"required": false,
						"description": "Default png",
						"schema": {
							"enum": ["png", "jpeg"],
							"type": "string"
						}
					},
					{
						"name": "quality",
						"in": "query",
						"required": false,
						"description": "JPEG quality 1-100",
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100
						}
					},
					{
						"name": "maxWidth",
						"in": "query",
						"required": false,
						"description": "Fit within this width",
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					},
					{
						"name": "maxHeight",
						"in": "query",
						"required": false,
						"description": "Fit within this height",
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					},
					{
						"name": "x",
						"in": "query",
						"required": false,
						"description": "Region left, before scaling",
						"schema": {
							"type": "integer",
							"minimum": 0
						}
					},
					{
						"name": "y",
						"in": "query",
						"required": false,
						"description": "Region top, before scaling",
						"schema": {
							"type": "integer",
							"minimum": 0
						}
					},
					{
						"name": "width",
						"in": "query",
						"required": false,
						"description": "Region width",
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					},
					{
						"name": "height",
						"in": "query",
						"required": false,
						"description": "Region height",
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"required": false,
						"description": "Draw the cursor (default true)",
						"schema": {
							"enum": ["true", "false"],
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "The image",
						"content": {
							"image/png": {
								"schema": {
									"type": "string",
									"format": "binary"
								}
							},
							"image/jpeg": {
								"schema": {
									"type": "string",
									"format": "binary"
								}
							}
						},
						"headers": {
							"Sbx-Screen-Width": {
								"description": "Screen width",
								"required": true,
								"schema": {
									"type": "integer"
								}
							},
							"Sbx-Screen-Height": {
								"description": "Screen height",
								"required": true,
								"schema": {
									"type": "integer"
								}
							},
							"Sbx-Image-Width": {
								"description": "Image width",
								"required": true,
								"schema": {
									"type": "integer"
								}
							},
							"Sbx-Image-Height": {
								"description": "Image height",
								"required": true,
								"schema": {
									"type": "integer"
								}
							},
							"Sbx-Cursor-X": {
								"description": "Cursor x (screen pixels)",
								"required": true,
								"schema": {
									"type": "integer"
								}
							},
							"Sbx-Cursor-Y": {
								"description": "Cursor y (screen pixels)",
								"required": true,
								"schema": {
									"type": "integer"
								}
							},
							"Cache-Control": {
								"description": "no-store",
								"required": true,
								"schema": {
									"enum": ["no-store"],
									"type": "string"
								}
							}
						}
					},
					"400": {
						"description": "`validation`, `invalid_action`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "`not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"409": {
						"description": "`sandbox_not_ready`, `desktop_not_ready`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"422": {
						"description": "`desktop_unsupported`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"503": {
						"description": "`streamer_unavailable`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"default": {
						"description": "Error; `error.code` says what happened",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/v1/sandboxes/{sandbox}/desktop/actions": {
			"post": {
				"operationId": "desktop.actions",
				"summary": "Input actions",
				"tags": ["desktop"],
				"description": "S10 §12.2, §13.2. Scope desktop. Actions run in order and stop at the first failure.",
				"parameters": [
					{
						"name": "sandbox",
						"in": "path",
						"required": true,
						"description": "Sandbox id (`sb_...`) or slug",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"description": "Optional",
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/DesktopActionsRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Done",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DesktopActionsResult"
								}
							}
						}
					},
					"400": {
						"description": "`validation`, `invalid_action` (details.index, details.reason)",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "`not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"409": {
						"description": "`sandbox_not_ready`, `desktop_not_ready`, `desktop_busy` (retryable)",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"422": {
						"description": "`desktop_unsupported`, `action_failed` (details.index, details.completed)",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"503": {
						"description": "`streamer_unavailable`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"default": {
						"description": "Error; `error.code` says what happened",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/v1/sandboxes/{sandbox}/desktop/clipboard": {
			"get": {
				"operationId": "desktop.clipboard.get",
				"summary": "Read the clipboard",
				"tags": ["desktop"],
				"description": "S10 §12.3, §13.2. Scope desktop.",
				"parameters": [
					{
						"name": "sandbox",
						"in": "path",
						"required": true,
						"description": "Sandbox id (`sb_...`) or slug",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Clipboard text",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DesktopClipboard"
								}
							}
						}
					},
					"404": {
						"description": "`not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"409": {
						"description": "`sandbox_not_ready`, `desktop_not_ready`",
