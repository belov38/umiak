								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"put": {
				"operationId": "desktop.clipboard.put",
				"summary": "Write the clipboard",
				"tags": ["desktop"],
				"description": "S10 §12.3, §13.2. Scope desktop. Text up to 1 MiB.",
