{
	"openapi": "3.1.0",
	"info": {
		"title": "sbx desktop API (S10 §13.2), contract fragment for the MCP fake",
		"version": "draft",
		"description": "Written by hand from docs/specs/s10-desktop.md §12-§13.2 because S10 is not implemented and apps/api/openapi/v1.json has no /desktop routes. openapi-check.ts merges `paths` and `components.schemas` into v1.json; `$ref`s such as #/components/schemas/Error resolve against the merged document. Replace this file with the real part of v1.json once S10 lands. Action field names are the camelCase of the S10 §12.2 table (delay_ms -> delayMs), like the rest of the public JSON. Not included: PUT /desktop/access, DELETE /desktop/streams (the MCP does not call them)."
	},
	"paths": {
		"/v1/sandboxes/{sandbox}/desktop": {
			"get": {
				"operationId": "desktop.get",
				"summary": "Desktop status",
				"tags": ["desktop"],
				"description": "S10 §13.2. Scope sandboxes:read. Templates without the `desktop` capability answer 422 `desktop_unsupported`.",
				"parameters": [
					{
						"name": "sandbox",
						"in": "path",
						"required": true,
						"description": "Sandbox id (`sb_...`) or slug",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Status",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DesktopStatus"
								}
							}
						}
					},
					"404": {
						"description": "`not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"409": {
						"description": "`sandbox_not_ready`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"422": {
						"description": "`desktop_unsupported`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"default": {
						"description": "Error; `error.code` says what happened",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
