	"components": {
		"schemas": {
			"DesktopPoint": {
				"type": "object",
				"additionalProperties": false,
				"required": ["x", "y"],
				"properties": {
					"x": {
						"type": "integer"
					},
					"y": {
						"type": "integer"
					}
				}
			},
			"DesktopSize": {
				"type": "object",
				"additionalProperties": false,
				"required": ["width", "height"],
				"properties": {
					"width": {
						"type": "integer",
						"minimum": 1
					},
					"height": {
						"type": "integer",
						"minimum": 1
					}
				}
			},
			"DesktopStatus": {
				"type": "object",
				"required": [
					"state",
					"reason",
					"screen",
					"cursor",
					"access",
					"url",
					"streamer"
				],
				"properties": {
					"state": {
						"enum": ["ready", "starting", "unavailable"],
						"type": "string"
					},
					"reason": {
						"type": ["string", "null"]
					},
					"screen": {
						"$ref": "#/components/schemas/DesktopSize"
					},
					"cursor": {
						"$ref": "#/components/schemas/DesktopPoint"
					},
					"access": {
						"enum": ["token", "sso", "public"],
						"type": "string"
					},
					"url": {
						"type": "string"
					},
					"streamer": {
						"type": "object",
						"required": ["running", "streaming"],
						"properties": {
							"running": {
								"type": "boolean"
							},
							"streaming": {
								"type": "boolean"
							}
						}
					}
				}
			},
			"DesktopLinkRequest": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"fps": {
						"enum": [30, 60],
						"type": "integer"
					},
					"bitrateKbps": {
						"type": "integer",
						"minimum": 1000,
						"maximum": 20000
					},
					"transport": {
						"enum": ["auto", "webrtc", "websocket"],
						"type": "string"
					}
				}
			},
			"DesktopLink": {
				"type": "object",
				"required": ["url", "expiresAt"],
				"properties": {
					"url": {
						"type": "string"
					},
					"expiresAt": {
						"type": "string",
						"format": "date-time"
					}
				}
			},
			"DesktopAction": {
				"description": "One input action (S10 §12.2); the field names are the camelCase of the table.",
				"oneOf": [
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["type", "x", "y"],
						"properties": {
							"type": {
								"const": "move"
							},
							"x": {
								"type": "integer"
							},
							"y": {
								"type": "integer"
							}
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["type"],
						"properties": {
							"type": {
								"const": "click"
							},
							"x": {
								"type": "integer"
							},
							"y": {
								"type": "integer"
							},
							"button": {
								"enum": ["left", "right", "middle"],
								"type": "string"
							},
							"count": {
								"type": "integer",
								"minimum": 1,
								"maximum": 3
							},
							"modifiers": {
								"type": "array",
								"items": {
									"enum": ["ctrl", "alt", "shift", "meta"],
									"type": "string"
								}
							}
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["type"],
						"properties": {
							"type": {
								"const": "mouse_down"
							},
							"x": {
								"type": "integer"
							},
							"y": {
								"type": "integer"
							},
							"button": {
								"enum": ["left", "right", "middle"],
								"type": "string"
							}
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["type"],
						"properties": {
							"type": {
								"const": "mouse_up"
							},
							"x": {
								"type": "integer"
							},
							"y": {
								"type": "integer"
							},
							"button": {
								"enum": ["left", "right", "middle"],
								"type": "string"
							}
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["type"],
						"properties": {
							"type": {
								"const": "scroll"
							},
							"x": {
								"type": "integer"
							},
							"y": {
								"type": "integer"
							},
							"dx": {
								"type": "integer"
							},
							"dy": {
								"type": "integer"
							}
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["type", "path"],
						"properties": {
							"type": {
								"const": "drag"
							},
							"path": {
								"type": "array",
								"minItems": 2,
								"items": {
									"$ref": "#/components/schemas/DesktopPoint"
								}
							},
							"button": {
								"enum": ["left", "right", "middle"],
								"type": "string"
							}
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["type", "keys"],
						"properties": {
							"type": {
								"const": "key"
							},
							"keys": {
								"type": "array",
								"minItems": 1,
								"items": {
									"type": "string"
								}
							}
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["type", "key"],
						"properties": {
							"type": {
								"const": "key_down"
							},
							"key": {
								"type": "string"
							}
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["type", "key"],
						"properties": {
							"type": {
								"const": "key_up"
							},
							"key": {
								"type": "string"
							}
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["type", "text"],
						"properties": {
							"type": {
								"const": "type"
							},
							"text": {
								"type": "string",
								"maxLength": 10000
							},
							"delayMs": {
								"type": "integer",
								"minimum": 0,
								"maximum": 100
							}
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["type", "ms"],
						"properties": {
							"type": {
								"const": "wait"
							},
							"ms": {
								"type": "integer",
								"minimum": 0,
								"maximum": 10000
							}
						}
					}
				]
			},
			"DesktopScreenshot": {
				"type": "object",
				"additionalProperties": false,
				"required": ["contentType", "width", "height", "data"],
				"properties": {
					"contentType": {
						"enum": ["image/png", "image/jpeg"],
						"type": "string"
					},
					"width": {
						"type": "integer"
					},
					"height": {
						"type": "integer"
					},
					"data": {
						"type": "string",
						"description": "base64"
					}
				}
			},
			"DesktopActionsRequest": {
				"type": "object",
				"additionalProperties": false,
				"required": ["actions"],
				"properties": {
					"actions": {
						"type": "array",
						"minItems": 1,
						"maxItems": 100,
						"items": {
							"$ref": "#/components/schemas/DesktopAction"
						}
					},
					"coordinateSpace": {
						"$ref": "#/components/schemas/DesktopSize"
					},
					"screenshot": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"format": {
								"enum": ["png", "jpeg"],
								"type": "string"
							},
							"quality": {
								"type": "integer",
								"minimum": 1,
								"maximum": 100
							},
							"maxWidth": {
								"type": "integer",
								"minimum": 1
							},
							"maxHeight": {
								"type": "integer",
								"minimum": 1
							}
						}
					}
				}
			},
			"DesktopActionsResult": {
				"type": "object",
				"required": ["completed", "cursor", "screen"],
				"properties": {
					"completed": {
						"type": "integer",
						"minimum": 0
					},
					"cursor": {
						"$ref": "#/components/schemas/DesktopPoint"
					},
					"screen": {
						"$ref": "#/components/schemas/DesktopSize"
					},
					"screenshot": {
						"$ref": "#/components/schemas/DesktopScreenshot"
					}
				}
			},
			"DesktopClipboard": {
				"type": "object",
				"required": ["text", "hasText"],
				"properties": {
					"text": {
						"type": "string"
					},
					"hasText": {
						"type": "boolean"
					}
				}
			},
			"DesktopClipboardWrite": {
				"type": "object",
				"additionalProperties": false,
				"required": ["text"],
				"properties": {
					"text": {
						"type": "string"
					}
				}
			}
		}
	}
}
