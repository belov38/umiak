{
	"name": "@sbx/worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Control plane worker: pg-boss handlers for operations, machine and snapshot jobs, agent events and controllers",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"sbx-admin": "./src/admin/main.ts"
	},
	"scripts": {
		"start": "node src/main.ts",
		"admin": "node src/admin/main.ts",
		"test": "vitest run",
		"typecheck": "pnpm --filter \"@sbx/agent-client...\" run build && tsc --noEmit -p ."
	},
	"dependencies": {
		"@sbx/agent-client": "workspace:*",
		"@sbx/config": "workspace:*",
		"@sbx/core": "workspace:*",
		"@sbx/db": "workspace:*",
		"@sbx/pve": "workspace:*",
		"pg": "8.23.1",
		"pg-boss": "12.38.0",
		"pino": "10.4.0",
		"prom-client": "15.1.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/pg": "8.23.1"
	}
}
