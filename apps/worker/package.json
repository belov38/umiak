{
	"name": "@umiak/worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Control plane worker: pg-boss handlers for operations, machine and snapshot jobs, agent events and controllers",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"umiak-admin": "./src/admin/main.ts"
	},
	"scripts": {
		"start": "node src/main.ts",
		"admin": "node src/admin/main.ts",
		"test": "vitest run",
		"typecheck": "pnpm --filter \"@umiak/agent-client...\" run build && tsc --noEmit -p ."
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.16.0",
		"@connectrpc/connect": "2.3.0",
		"@umiak/agent-client": "workspace:*",
		"@umiak/auth": "workspace:*",
		"@umiak/config": "workspace:*",
		"@umiak/core": "workspace:*",
		"@umiak/db": "workspace:*",
		"@umiak/payload": "workspace:*",
		"@umiak/proto": "workspace:*",
		"@umiak/pve": "workspace:*",
		"pg": "8.23.1",
		"pg-boss": "12.38.0",
		"pino": "10.4.0",
		"prom-client": "15.1.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"yaml": "2.9.1"
	}
}
