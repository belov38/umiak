{
	"name": "@umiak/cli",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "umiak: the command line of the umiak public API (Bun, on @umiak/sdk): login, profiles, sandboxes, commands, files, ports",
	"bin": {
		"umiak": "./src/main.ts"
	},
	"scripts": {
		"umiak": "bun src/main.ts",
		"build": "bun scripts/build.ts",
		"build:all": "bun scripts/build.ts --all",
		"test": "vitest run",
		"typecheck": "pnpm --filter \"@umiak/agent-client...\" run build && tsc --noEmit -p ."
	},
	"dependencies": {
		"@umiak/auth": "workspace:*",
		"@umiak/mcp": "workspace:*",
		"@umiak/sdk": "workspace:*",
		"commander": "15.0.0"
	},
	"devDependencies": {
		"@umiak/api": "workspace:*",
		"@umiak/core": "workspace:*",
		"@umiak/db": "workspace:*"
	}
}
