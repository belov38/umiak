{
	"components": {
		"parameters": {},
		"schemas": {
			"Error": {
				"description": "Error envelope of every non-2xx response (S7 §5.5)",
				"properties": {
					"error": {
						"properties": {
							"code": {
								"description": "Stable snake_case error code; new codes may be added within v1",
								"example": "operation_in_progress",
								"type": "string"
							},
							"details": {
								"additionalProperties": {},
								"description": "Code-specific details; may be empty",
								"type": "object"
							},
							"message": {
								"description": "What happened and what to do next, in English",
								"type": "string"
							},
							"requestId": {
								"example": "req_01jbx2v7d3m6c8q9w0e4r5t6y7",
								"type": "string"
							},
							"retryable": {
								"description": "Repeating the same request is safe and may succeed later",
								"type": "boolean"
							}
						},
						"required": [
							"code",
							"message",
							"retryable",
							"details",
							"requestId"
						],
						"type": "object"
					}
				},
				"required": [
					"error"
				],
				"type": "object"
			},
			"Me": {
				"properties": {
					"auth": {
						"properties": {
							"apiKeyId": {
								"description": "Team keys only",
								"example": "key_01jbx2v7d3m6c8q9w0e4r5t6y7",
								"type": "string"
							},
							"createdBy": {
								"description": "Team keys only: who issued the key (audit)",
								"properties": {
									"active": {
										"type": "boolean"
									},
									"email": {
										"type": "string"
									},
									"id": {
										"type": "string"
									},
									"member": {
										"type": "boolean"
									}
								},
								"required": [
									"id",
									"email",
									"active",
									"member"
								],
								"type": [
									"object",
									"null"
								]
							},
							"expiresAt": {
								"description": "Expiry of the key or the access token; absent for browser sessions",
								"format": "date-time",
								"type": "string"
							},
							"kind": {
								"enum": [
									"session",
									"oidc",
									"team_key"
								],
								"type": "string",
								"x-extensible-enum": true
							},
							"scopes": {
								"items": {
									"enum": [
										"sandboxes:read",
										"sandboxes:write",
										"sandboxes:delete",
										"commands:read",
										"commands:exec",
										"files:read",
										"files:write",
										"ports:write",
										"ssh:connect",
										"snapshots:read",
										"snapshots:write",
										"environments:read",
										"environments:write",
										"keys:admin"
									],
									"type": "string",
									"x-extensible-enum": true
								},
								"type": "array"
							}
						},
						"required": [
							"kind",
							"scopes"
						],
						"type": "object"
					},
					"isOperator": {
						"description": "Platform operator rights; only in a browser session",
						"type": "boolean"
					},
					"team": {
						"$ref": "#/components/schemas/MeTeam"
					},
					"teams": {
						"description": "Teams of the person; a team key sees only its own team",
						"items": {
							"$ref": "#/components/schemas/MeTeam"
						},
						"type": "array"
					},
					"user": {
						"description": "The person; null for a team API key",
						"properties": {
							"email": {
								"type": "string"
							},
							"id": {
								"example": "usr_01jbx2v7d3m6c8q9w0e4r5t6y7",
								"type": "string"
							},
							"name": {
								"type": [
									"string",
									"null"
								]
							}
						},
						"required": [
							"id",
							"email",
							"name"
						],
						"type": [
							"object",
							"null"
						]
					}
				},
				"required": [
					"user",
					"team",
					"teams",
					"isOperator",
					"auth"
				],
				"type": "object"
			},
			"MeTeam": {
				"description": "Team of this request (Sbx-Team or the default team)",
				"properties": {
					"id": {
						"example": "team_01jbx2v7d3m6c8q9w0e4r5t6y7",
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"role": {
						"description": "Role in the team; null for team keys and operators outside the team",
						"enum": [
							"owner",
							"member",
							null
						],
						"type": [
							"string",
							"null"
						],
						"x-extensible-enum": true
					}
				},
				"required": [
					"id",
					"name",
					"role"
				],
				"type": "object"
			},
			"Meta": {
				"properties": {
					"apiUrl": {
						"example": "https://api.example.com",
						"format": "uri",
						"type": "string"
					},
					"apiVersion": {
						"example": "v1",
						"type": "string"
					},
					"appUrl": {
						"example": "https://app.example.com",
						"format": "uri",
						"type": "string"
					},
					"build": {
						"description": "Build of the api",
						"example": "1.4.0+3f2c1a9",
						"type": "string"
					},
					"latestCliVersion": {
						"example": "0.5.1",
						"type": [
							"string",
							"null"
						]
					},
					"minCliVersion": {
						"description": "Older CLIs warn and keep working",
						"example": "0.4.0",
						"type": [
							"string",
							"null"
						]
					},
					"oidc": {
						"description": "Keycloak for people (device flow of `sbx login`); null when only team keys work",
						"properties": {
							"audience": {
								"example": "sbx-api",
								"type": "string"
							},
							"clientId": {
								"example": "sbx-cli",
								"type": "string"
							},
							"issuer": {
								"format": "uri",
								"type": "string"
							}
						},
						"required": [
							"issuer",
							"clientId",
							"audience"
						],
						"type": [
							"object",
							"null"
						]
					},
					"sbxDomain": {
						"description": "Domain of published ports: https://<slug>-<port>.<sbxDomain>",
						"example": "sbx.example.com",
						"type": "string"
					},
					"ssh": {
						"properties": {
							"host": {
								"example": "ssh.example.com",
								"type": "string"
							},
							"hostKeys": {
								"description": "Gateway host keys for known_hosts, \"<type> <base64>\"",
								"items": {
									"type": "string"
								},
								"type": "array"
							},
							"port": {
								"maximum": 65535,
								"minimum": 1,
								"type": "integer"
							}
						},
						"required": [
							"host",
							"port",
							"hostKeys"
						],
						"type": "object"
					}
				},
				"required": [
					"apiVersion",
					"build",
					"appUrl",
					"apiUrl",
					"sbxDomain",
					"oidc",
					"ssh",
					"minCliVersion",
					"latestCliVersion"
				],
				"type": "object"
			}
		},
		"securitySchemes": {
			"keycloak": {
				"description": "Keycloak access token of a person (CLI, SDK, MCP)",
				"openIdConnectUrl": "https://auth.example.com/realms/sbx/.well-known/openid-configuration",
				"type": "openIdConnect"
			},
			"teamKey": {
				"bearerFormat": "sbx_",
				"description": "Team API key (sbx_...) for automation and CI",
				"scheme": "bearer",
				"type": "http"
			}
		}
	},
	"info": {
		"description": "API of sbx: VM sandboxes for AI agents on Proxmox VE.\n\nErrors always have the shape {error: {code, message, retryable, details, requestId}}.\nEvery response carries a Request-Id header.",
		"title": "sbx API",
		"version": "v1"
	},
	"openapi": "3.1.0",
	"paths": {
		"/v1/docs": {
			"get": {
				"description": "Interactive HTML reference (Scalar) rendered from `/v1/openapi.json`. Needs no authentication.",
				"operationId": "meta.docs",
				"responses": {
					"200": {
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						},
						"description": "HTML page"
					},
					"default": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						},
						"description": "Error; `error.code` says what happened"
					}
				},
				"security": [],
				"summary": "API reference page",
				"tags": [
					"meta"
				]
			}
		},
		"/v1/me": {
			"get": {
				"description": "Who is calling: the person (null for a team API key), the team this request acts in, the person's teams with roles, operator rights, and the credential (kind, scopes, expiry). `sbx login` and `sbx whoami` call it to show the account and the default team.",
				"operationId": "me.get",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Me"
								}
							}
						},
						"description": "The caller"
					},
					"default": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						},
						"description": "Error; `error.code` says what happened"
					}
				},
				"summary": "Current caller",
				"tags": [
					"account"
				]
			}
		},
		"/v1/meta": {
			"get": {
				"description": "Public facts about this deployment: API and dashboard URLs, the domain of published ports, the Keycloak issuer for `sbx login`, the SSH endpoint with its host keys, and CLI versions. Needs no authentication; clients call it first to configure themselves.",
				"operationId": "meta.get",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Meta"
								}
							}
						},
						"description": "Platform information"
					},
					"default": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						},
						"description": "Error; `error.code` says what happened"
					}
				},
				"security": [],
				"summary": "Platform information",
				"tags": [
					"meta"
				]
			}
		},
		"/v1/openapi.json": {
			"get": {
				"description": "This OpenAPI 3.1 document, with the server URL and Keycloak issuer of this deployment. Needs no authentication. SDKs are generated from it.",
				"operationId": "meta.openapi",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"additionalProperties": {},
									"type": "object"
								}
							}
						},
						"description": "OpenAPI 3.1 document"
					},
					"default": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						},
						"description": "Error; `error.code` says what happened"
					}
				},
				"security": [],
				"summary": "OpenAPI document",
				"tags": [
					"meta"
				]
			}
		}
	},
	"security": [
		{
			"keycloak": []
		},
		{
			"teamKey": []
		}
	],
	"servers": [
		{
			"url": "https://api.example.com"
		}
	],
	"webhooks": {}
}
