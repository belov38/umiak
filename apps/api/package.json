{
	"name": "@umiak/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Public API v1: Hono + zod-openapi app with the public, proxied, internal and ops listeners",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing/index.ts"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "pnpm --filter \"@umiak/agent-client...\" run build && tsc --noEmit -p .",
		"openapi": "node scripts/openapi.ts"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.16.0",
		"@connectrpc/connect": "2.3.0",
		"@hono/node-server": "2.1.5",
		"@hono/zod-openapi": "1.6.3",
		"@umiak/agent-client": "workspace:*",
		"@umiak/auth": "workspace:*",
		"@umiak/config": "workspace:*",
		"@umiak/core": "workspace:*",
		"@umiak/db": "workspace:*",
		"@umiak/payload": "workspace:*",
		"@umiak/proto": "workspace:*",
		"hono": "4.13.14",
		"jose": "6.2.14",
		"pg": "8.23.1",
		"pg-boss": "12.38.0",
		"pino": "10.4.0",
		"prom-client": "15.1.3",
		"rate-limiter-flexible": "11.2.3",
		"ws": "8.22.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"@types/ws": "8.18.2",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"fast-check": "4.10.2"
	}
}
