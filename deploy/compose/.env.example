# Local overrides of the compose stack. Copy to deploy/compose/.env (git-ignored):
#   cp deploy/compose/.env.example deploy/compose/.env
# Every variable is optional; the defaults are in compose.yaml.

# ---- Proxmox VE --------------------------------------------------------------
# Any Proxmox host the containers can reach. Without these the stack expects a
# host named `pve` (https://pve:8006, TLS name pve, SSH to pve).
# The values below are the dev values of Ilia's homelab, reached over Tailscale
# from the dev machine; replace them with your own host.
UMIAK_PVE_URL=https://100.64.10.2:8006
UMIAK_PVE_TLS_NAME=pve
UMIAK_NODE_SSH_HOST=100.64.10.2
# UMIAK_PVE_TOKEN_ID=umiak@pve!dev
# UMIAK_PVE_SECRETS_DIR=/path/to/dir/with/pve-token  # default ~/.config/umiak
# UMIAK_RECONCILE_DRY_RUN=1

# ---- Keycloak (realm umiak) ----------------------------------------------------
# Admin console http://localhost:8180/admin (created on the first start only).
# Without KEYCLOAK_ADMIN_PASSWORD the password is generated by secrets-init:
#   docker compose -f deploy/compose/compose.yaml exec keycloak cat /run/umiak-secrets/admin-password
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=
# Temporary password of dev@example.com; Keycloak asks for a new one at the
# first login. Used only when the realm is imported (first start).
UMIAK_DEV_PASSWORD=dev

# Host ports are fixed (127.0.0.1): api 8080, api ops 9091, Keycloak 8180,
# oauth2-proxy 4180. The public URLs below default to them.
# UMIAK_API_LOG_LEVEL=info

# ---- Public URLs (behind a TLS proxy; set them together, README "Публичные адреса")
# The realm takes UMIAK_APP_ORIGIN and UMIAK_OAUTH2_PROXY_REDIRECT_URL on its first
# import only.
# UMIAK_API_PUBLIC_URL=http://localhost:8080
# Remote MCP server (S11): the URL clients use and extra Host values.
# UMIAK_MCP_PUBLIC_URL=http://localhost:8090/mcp
# UMIAK_MCP_ALLOWED_HOSTS=127.0.0.1:8090
# UMIAK_MCP_LOG_LEVEL=info
# UMIAK_APP_ORIGIN=http://localhost:4180
# UMIAK_KEYCLOAK_URL=http://localhost:8180
# Default <UMIAK_KEYCLOAK_URL>/realms/umiak and <UMIAK_APP_ORIGIN>/oauth2/callback.
# UMIAK_OIDC_ISSUER=http://localhost:8180/realms/umiak
# UMIAK_OAUTH2_PROXY_REDIRECT_URL=http://localhost:4180/oauth2/callback
# Gateway port SSO; default <UMIAK_APP_ORIGIN>/umiak-auth/authorize.
# UMIAK_GATEWAY_AUTH_URL=http://localhost:4180/umiak-auth/authorize
# UMIAK_OAUTH2_PROXY_WHITELIST_DOMAIN=localhost:4180
# Behind TLS: __Host-umiak_session, Secure, and X-Forwarded-* from the proxy.
# UMIAK_OAUTH2_PROXY_COOKIE_NAME=_umiak_session
# UMIAK_OAUTH2_PROXY_COOKIE_SECURE=false
# UMIAK_OAUTH2_PROXY_REVERSE_PROXY=false
# UMIAK_PREVIEW_DOMAIN=umiak.localhost
# X-Forwarded-For counts for the api log only from these peers.
# UMIAK_API_TRUSTED_PROXY_CIDRS=
# Keycloak behind a TLS proxy: xforwarded (or forwarded) and the proxy's CIDRs.
# UMIAK_KEYCLOAK_PROXY_HEADERS=
# UMIAK_KEYCLOAK_PROXY_TRUSTED_ADDRESSES=

# ---- api ---------------------------------------------------------------------
# SSH address shown in /v1/meta and `umiak ssh` (the S4 gateway publishes 2222).
# UMIAK_SSH_HOST=ssh.localhost
# UMIAK_SSH_PORT=2222

# ---- S4 gateway (gateway.yaml, included by compose.yaml) --------------------
# The gateway calls the api internal listener for routes, SSH and agent events
# (default http://api:8082). Set "none" to run the gateway without api.
# UMIAK_GATEWAY_API_URL=http://api:8082
