# Local overrides of the compose stack. Copy to deploy/compose/.env (git-ignored):
#   cp deploy/compose/.env.example deploy/compose/.env
# Every variable is optional; the defaults are in compose.yaml.

# ---- Proxmox VE --------------------------------------------------------------
# Any Proxmox host the containers can reach. Without these the stack expects a
# host named `pve` (https://pve:8006, TLS name pve, SSH to pve).
# The values below are the dev values of Ilia's homelab, reached over Tailscale
# from the dev machine; replace them with your own host.
SBX_PVE_URL=https://100.64.10.2:8006
SBX_PVE_TLS_NAME=pve
SBX_NODE_SSH_HOST=100.64.10.2
# SBX_PVE_TOKEN_ID=sbx@pve!poc
# SBX_PVE_SECRETS_DIR=/path/to/dir/with/pve-token  # default ~/.config/sbx
# SBX_RECONCILE_DRY_RUN=1

# ---- Keycloak (realm sbx) ----------------------------------------------------
# Admin console http://localhost:8180/admin (created on the first start only).
# Without KEYCLOAK_ADMIN_PASSWORD the password is generated by secrets-init:
#   docker compose -f deploy/compose/compose.yaml exec keycloak cat /run/sbx-secrets/admin-password
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=
# Temporary password of dev@example.com; Keycloak asks for a new one at the
# first login. Used only when the realm is imported (first start).
SBX_DEV_PASSWORD=dev

# Host ports are fixed (127.0.0.1): api 8080, api ops 9091, Keycloak 8180,
# oauth2-proxy 4180. The public URLs below default to them.
# SBX_API_LOG_LEVEL=info

# ---- Public URLs (behind a TLS proxy; set them together, README "Публичные адреса")
# The realm takes SBX_APP_ORIGIN and SBX_OAUTH2_PROXY_REDIRECT_URL on its first
# import only.
# SBX_API_PUBLIC_URL=http://localhost:8080
# SBX_APP_ORIGIN=http://localhost:4180
# SBX_KEYCLOAK_URL=http://localhost:8180
# Default <SBX_KEYCLOAK_URL>/realms/sbx and <SBX_APP_ORIGIN>/oauth2/callback.
# SBX_OIDC_ISSUER=http://localhost:8180/realms/sbx
# SBX_OAUTH2_PROXY_REDIRECT_URL=http://localhost:4180/oauth2/callback
# Gateway port SSO; default <SBX_APP_ORIGIN>/sbx-auth/authorize.
# SBX_GATEWAY_AUTH_URL=http://localhost:4180/sbx-auth/authorize
# SBX_OAUTH2_PROXY_WHITELIST_DOMAIN=localhost:4180
# Behind TLS: __Host-sbx_session, Secure, and X-Forwarded-* from the proxy.
# SBX_OAUTH2_PROXY_COOKIE_NAME=_sbx_session
# SBX_OAUTH2_PROXY_COOKIE_SECURE=false
# SBX_OAUTH2_PROXY_REVERSE_PROXY=false
# SBX_SBX_DOMAIN=sbx.localhost
# X-Forwarded-For counts for the api log only from these peers.
# SBX_API_TRUSTED_PROXY_CIDRS=
# Keycloak behind a TLS proxy: xforwarded (or forwarded) and the proxy's CIDRs.
# SBX_KEYCLOAK_PROXY_HEADERS=
# SBX_KEYCLOAK_PROXY_TRUSTED_ADDRESSES=

# ---- api ---------------------------------------------------------------------
# SSH address shown in /v1/meta and `sbx ssh` (the S4 gateway publishes 2222).
# SBX_SSH_HOST=ssh.localhost
# SBX_SSH_PORT=2222

# ---- S4 gateway (gateway.yaml, included by compose.yaml) --------------------
# The gateway calls the api internal listener for routes, SSH and agent events
# (default http://api:8082). Set "none" to run the gateway without api.
# SBX_GATEWAY_API_URL=http://api:8082
