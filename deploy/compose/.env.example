# Local overrides of the compose stack. Copy to deploy/compose/.env (git-ignored):
#   cp deploy/compose/.env.example deploy/compose/.env
# Every variable is optional; the defaults are in compose.yaml.

# ---- Proxmox VE --------------------------------------------------------------
# Any Proxmox host the containers can reach. Without these the stack expects a
# host named `pve` (https://pve:8006, TLS name pve, SSH to pve).
# The values below are the dev values of Ilia's homelab, reached over Tailscale
# from the dev machine; replace them with your own host.
SBX_PVE_URL=https://100.64.10.2:8006
SBX_PVE_TLS_NAME=pve
SBX_NODE_SSH_HOST=100.64.10.2
# SBX_PVE_TOKEN_ID=sbx@pve!poc
# SBX_PVE_SECRETS_DIR=/path/to/dir/with/pve-token  # default ~/.config/sbx
# SBX_RECONCILE_DRY_RUN=1

# ---- Keycloak (realm sbx) ----------------------------------------------------
# Admin console http://localhost:8180/admin (created on the first start only).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Temporary password of dev@example.com; Keycloak asks for a new one at the
# first login. Used only when the realm is imported (first start).
SBX_DEV_PASSWORD=dev

# ---- Host ports (all on 127.0.0.1) -------------------------------------------
# API_PORT=8080            # api public listener (SDK, CLI)
# API_METRICS_PORT=9091    # api /healthz, /readyz, /metrics
# KEYCLOAK_PORT=8180       # Keycloak; also its public address (token issuer)
# OAUTH2_PROXY_PORT=4180   # browser sessions: /api/*, /sbx-auth/*
# SBX_API_LOG_LEVEL=info

# ---- api ---------------------------------------------------------------------
# SSH address shown in /v1/meta and `sbx ssh` (the S4 gateway publishes 2222).
# SBX_SSH_HOST=127.0.0.1
# SBX_SSH_PORT=2222

# ---- S4 gateway (when gateway.yaml is included, see compose.yaml) -------------
# The gateway calls the api internal listener for routes, SSH and agent events.
# SBX_GATEWAY_API_URL=http://api:8082
