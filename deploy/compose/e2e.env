# Variables of the E2E stack (deploy/compose/e2e.yaml), passed with
# --env-file instead of deploy/compose/.env, so the dev settings of a local
# stack never leak in. Host ports differ from the dev stack's: both can run
# at once. Dev-only values.
UMIAK_E2E_PG_PORT=15432
UMIAK_E2E_KEYCLOAK_PORT=18180
UMIAK_E2E_APP_PORT=14180
UMIAK_E2E_API_PORT=18080
UMIAK_E2E_CONTROL_PORT=19099
UMIAK_KEYCLOAK_URL=http://localhost:18180
UMIAK_APP_ORIGIN=http://localhost:14180
UMIAK_API_PUBLIC_URL=http://localhost:18080
UMIAK_OAUTH2_PROXY_WHITELIST_DOMAIN=localhost:14180
UMIAK_OAUTH2_PROXY_WHITELIST_KEYCLOAK=localhost:18180
UMIAK_OAUTH2_PROXY_COOKIE_NAME=_umiak_e2e_session
# Admin of the master realm: global setup creates the test users with it.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=e2e-keycloak-admin
