# Keep the build context small and free of local-only material and secrets.
.git
.gitignore
.DS_Store
.idea
.vscode
node_modules
**/node_modules
dist
coverage
*.tsbuildinfo
bench-results

# Local research material and agent working files
research
sdks
vendor-repos
scripts
.superpowers
.claude
docs

# Secrets and local env, at any depth
**/.env
**/.env.*
**/*.pem
**/*.key
deploy/compose/secrets

# Go and unrelated services
services
bin

# web: the dev auth stand-in, tests and local build output never enter the image
apps/web/dev
apps/web/test
apps/web/.next
apps/web/next-env.d.ts
apps/web/e2e
apps/web/test-results
apps/web/playwright-report
apps/web/e2e/.state
